# Variables para Docker Compose (copiar a .env en la raíz del proyecto)
# Usadas por: backend, mysql, redis, phpmyadmin

# Entorno y servidor
NODE_ENV=production
PORT=3000

# MySQL (usado por backend, mysql y phpmyadmin)
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=tjpubls

# Redis (opcional: dejar vacío si Redis no tiene contraseña)
REDIS_PASSWORD=

# JWT (cambiar JWT_SECRET en producción)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
