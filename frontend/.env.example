# Variables para el frontend Vite (copiar a .env en frontend/)
# VITE_* se exponen al cliente; solo incluir variables públicas.

# URL base de la API (sin / al final)
# Desarrollo local con Docker: http://localhost/api/v1
# Desarrollo local backend: http://localhost:3000/api/v1
VITE_API_URL=http://localhost/api/v1
