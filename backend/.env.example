# Variables de entorno del backend (copiar a .env y completar con valores reales)

# Entorno y servidor
NODE_ENV=production
PORT=3000

# PostgreSQL - Neon (https://neon.tech)
# En el panel de Neon: Project → Connection string → copiar la URI (debe incluir ?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:npg_5vtK2PHyYwkQ@ep-royal-surf-a450csbl-pooler.us-east-1.aws.neon.tech/data_publs?sslmode=require&channel_binding=require

# Redis (opcional)
# Si no usas Redis en local, pon REDIS_DISABLED=true para arrancar sin caché
REDIS_DISABLED=true
REDIS_PASSWORD=

# JWT (cambiar JWT_SECRET en producción)
JWT_SECRET=cambiar_por_secreto_seguro
JWT_EXPIRES_IN=24h

# CORS - URL del frontend (Render, Vercel, etc.)
FRONTEND_URL=https://tjpubls-web.onrender.com
