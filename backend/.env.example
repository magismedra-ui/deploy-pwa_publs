# Variables para el backend (copiar a .env en backend/)
# Desarrollo local: DB_HOST=localhost, REDIS_HOST=localhost
# Con Docker: DB_HOST=mysql, REDIS_HOST=redis

NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=tjpubls

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (cambiar JWT_SECRET en producción)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
